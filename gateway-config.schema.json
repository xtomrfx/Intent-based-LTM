{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f5.example/schema/gateway-config.schema.json",
  "title": "F5 LTM AI Gateway Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "northbound",
    "resources",
    "model_endpoints",
    "pipeline",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "northbound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_chat_completions",
        "allow_responses"
      ],
      "properties": {
        "allow_chat_completions": { "type": "boolean" },
        "allow_responses": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifiers"],
      "properties": {
        "classifiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/classifierEndpoint" }
        }
      }
    },
    "model_endpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/modelEndpoint" }
    },
    "pipeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/pipelineStage" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_tag", "config_reload_interval_ms", "request_limits"],
      "properties": {
        "fallback_tag": {
          "type": "string",
          "minLength": 1
        },
        "config_reload_interval_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "request_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_plane_bytes",
            "admin_plane_bytes",
            "classifier_prompt_chars"
          ],
          "properties": {
            "data_plane_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "admin_plane_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "classifier_prompt_chars": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "providerType": {
      "type": "string",
      "enum": ["openai", "openai_like"]
    },
    "sharedEndpoint": {
      "type": "object",
      "required": [
        "provider_type",
        "base_url",
        "model",
        "timeout_ms"
      ],
      "properties": {
        "provider_type": { "$ref": "#/$defs/providerType" },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "pattern": "^/.*"
        },
        "api_key": { "type": "string" },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "classifierEndpoint": {
      "allOf": [
        { "$ref": "#/$defs/sharedEndpoint" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["classification_prompt_template"],
          "properties": {
            "classification_prompt_template": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "modelEndpoint": {
      "allOf": [
        { "$ref": "#/$defs/sharedEndpoint" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "accept_client_model": { "type": "boolean" },
            "client_model_aliases": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "system_prompt": { "type": "string" },
            "max_tokens": { "type": "number" },
            "temperature": { "type": "number" }
          }
        }
      ]
    },
    "semanticPolicyRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "drop" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "message"],
          "properties": {
            "action": { "const": "respond" },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "endpoint"],
          "properties": {
            "action": { "const": "route" },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "pipelineOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "drop" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "message"],
          "properties": {
            "action": { "const": "respond" },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "endpoint"],
          "properties": {
            "action": { "const": "route" },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "value"],
          "properties": {
            "action": { "const": "set_system_prompt" },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "policyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "then"],
      "properties": {
        "id": { "type": "string" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": { "type": "string", "minLength": 1 },
            "confidence_gte": { "type": "number" },
            "northbound_type": { "type": "string", "enum": ["chat", "responses"] },
            "client_model": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "tenant": { "type": "string", "minLength": 1 },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "prompt_regex": { "type": "string", "minLength": 1 }
          }
        },
        "then": {
          "oneOf": [
            { "$ref": "#/$defs/pipelineOperation" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/pipelineOperation" }
            }
          ]
        }
      }
    },
    "pipelineStage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "const": "normalize" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "classifier"],
          "properties": {
            "name": { "const": "classify" },
            "classifier": {
              "type": "string",
              "minLength": 1
            },
            "prompt_template": { "type": "string" },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "rules"],
          "properties": {
            "name": { "const": "policy" },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/policyRule" }
            },
            "default": {
              "oneOf": [
                { "$ref": "#/$defs/pipelineOperation" },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/pipelineOperation" }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "const": "invoke_model" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "const": "egress_transform" }
          }
        }
      ]
    }
  }
}
