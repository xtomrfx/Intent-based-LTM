{
  "schema_version": 1,
  "northbound": {
    "allow_chat_completions": true,
    "allow_responses": true
  },
  "resources": {
    "classifiers": {
      "intent_cls": {
        "provider_type": "openai_like",
        "base_url": "https://api.deepseek.com",
        "path": "/chat/completions",
        "api_key": "REPLACE_CLASSIFIER_KEY",
        "model": "deepseek-chat",
        "timeout_ms": 10000,
        "classification_prompt_template": "You are a routing classifier inside an AI gateway. Classify the user input into exactly one tag from: {{tags}}. Return only compact JSON like {\"tag\":\"unknown\",\"confidence\":0.92}. Use chat for casual small talk. Use f5 for F5 product, BIG-IP, iRule, ASM, APM, LTM, GTM, NGINX, distributed cloud, or related implementation and troubleshooting questions. Use bad for sexual or violent harmful requests. Use unknown when unsure."
      }
    }
  },
  "model_endpoints": {
    "cheap_like": {
      "provider_type": "openai_like",
      "base_url": "https://api.deepseek.com",
      "path": "/chat/completions",
      "api_key": "REPLACE_MODEL_KEY",
      "model": "deepseek-chat",
      "timeout_ms": 45000,
      "accept_client_model": false,
      "system_prompt": "You are a general-purpose assistant. Reply in Chinese and keep the answer concise.",
      "max_tokens": 128,
      "temperature": 0.2
    },
    "engineering_openai": {
      "provider_type": "openai",
      "base_url": "https://api.deepseek.com",
      "path": "/v1/chat/completions",
      "api_key": "REPLACE_MODEL_KEY",
      "model": "deepseek-chat",
      "timeout_ms": 45000,
      "accept_client_model": false,
      "system_prompt": "You are an F5 engineering assistant. Provide practical and technically correct answers, preferably in Chinese.",
      "max_tokens": 512,
      "temperature": 0.2
    }
  },
  "runtime": {
    "fallback_tag": "unknown",
    "config_reload_interval_ms": 1000,
    "request_limits": {
      "data_plane_bytes": 524288,
      "admin_plane_bytes": 262144,
      "classifier_prompt_chars": 16384
    }
  },
  "pipeline": [
    { "name": "normalize" },
    {
      "name": "classify",
      "classifier": "intent_cls",
      "tags": ["chat", "f5", "bad", "unknown"],
      "prompt_template": "You are a routing classifier inside an AI gateway. Classify the user input into exactly one tag from: {{tags}}. Return only compact JSON like {\"tag\":\"unknown\",\"confidence\":0.92}. Use chat for casual small talk. Use f5 for F5 product, BIG-IP, iRule, ASM, APM, LTM, GTM, NGINX, distributed cloud, or related implementation and troubleshooting questions. Use bad for sexual or violent harmful requests. Use unknown when unsure."
    },
    {
      "name": "policy",
      "rules": [
        {
          "id": "rule_bad_respond",
          "when": { "tag": "bad" },
          "then": [
            { "action": "respond", "message": "您的请求违规" }
          ]
        },
        {
          "id": "rule_chat_respond",
          "when": { "tag": "chat" },
          "then": [
            { "action": "respond", "message": "工作时间请不要闲聊" }
          ]
        },
        {
          "id": "rule_f5_header_route",
          "when": {
            "tag": "f5",
            "headers": {
              "x-demo-lane": "expert"
            }
          },
          "then": [
            { "action": "set_system_prompt", "value": "You are an F5 engineering assistant. Answer in Chinese with concise but technically correct guidance." },
            { "action": "route", "endpoint": "engineering_openai" }
          ]
        },
        {
          "id": "rule_f5_route",
          "when": { "tag": "f5", "confidence_gte": 0.8 },
          "then": [
            { "action": "set_system_prompt", "value": "You are an F5 engineering assistant. Answer in Chinese with concise but technically correct guidance." },
            { "action": "route", "endpoint": "engineering_openai" }
          ]
        }
      ],
      "default": [
        { "action": "route", "endpoint": "cheap_like" }
      ]
    },
    { "name": "invoke_model" }
  ]
}
